# Example .env file for backend


DATABASE_URL=sqlite:///data/leads.db

# comma-separated list of staff emails that can receive magic links
STAFF_ALLOWLIST=example@email.com,example2@email.com

# log fallback for magic links, True means links are logged
LOG_MAGIC_LINKS=True

# Must be true for frontend served over HTTPS (Vercel -> local API). samesite="none" in auth.py
SECURE_COOKIES=True

# frontend domain (make sure there is no trailing slash)
# If using localhost, set to http://localhost:3000
FRONTEND_DOMAIN=https://leadflow-iota-one.vercel.app

# resend api key
RESEND_API_KEY=

# email address to send login links from (must be a verified resend sender)
RESEND_SENDER_EMAIL=noreply@auth.workwithvika.com

# leave as is
# generates demo leads data on startup
# false by default for pytest to run without generating demo data
# docker sets to true automatically when running via Compose
GENERATE_DEMO_DATA=False